<?xml version="1.0" encoding="utf-8"?>
<!-- 七牛测试域名（*.clouddn.com）HTTPS 证书常不匹配，需允许 http 明文播放。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
