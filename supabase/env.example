# 复制本文件为 env.local 后填入真实值（env.local / dart_defines.json 不会提交）
# 打包 APK：在项目根目录执行 .\build_apk.ps1

# ========== 打进 App（公开配置）==========

# Supabase 项目（区域建议 Singapore）。Dashboard → Settings → API
# URL + anon key 可进 APK；切勿把 service_role 打进安装包
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# 登录后默认开同步（owner 由 Auth 会话绑定）
SYNC_ENABLED=true

# 七牛云（房间视频，优先）。控制台 → 密钥管理 / 空间管理
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 空间绑定的 CDN 域名（需能公网访问），不要末尾 /
# 注意：*.clouddn.com 测试域名 https 证书常无效，请用 http://；正式自定义域名再用 https://
QINIU_PUBLIC_BASE=http://xxx.hd-bkt.clouddn.com
# 上传域名按空间区域选：华东 upload.qiniup.com / 华北 upload-z1 / 华南 upload-z2
QINIU_UPLOAD_HOST=https://upload.qiniup.com
# 可选：多媒体队列名（云端转码暂未启用；以后若打开再填）
QINIU_PIPELINE=

# Cloudflare R2（备用：七牛失败时）。Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 桶的公开访问前缀（r2.dev 或自定义域名），不要末尾 /
R2_PUBLIC_BASE=https://pub-xxxx.r2.dev

# 分享站根地址（EdgeOne Makers / 国内域名，部署 share-web 后填写）
SHARE_WEB_BASE=https://your-project.edgeone.app
# 分享页「下载 App」链接；不填则打包时默认 {QINIU_PUBLIC_BASE}/app/rent_agent.apk
APP_DOWNLOAD_URL=
APP_DOWNLOAD_HINT=点击下载缘初 App（Android）
# 可选：更新清单地址。不填则默认 {QINIU_PUBLIC_BASE}/app/version.json
APP_UPDATE_MANIFEST_URL=

# 微信开放平台移动应用（分享网页卡片必需）
WECHAT_APP_ID=
WECHAT_UNIVERSAL_LINK=

# ========== 仅 migrate 机器用（勿 bake 进 APK）==========
# Supabase / 托管 Postgres 连接串，供 python supabase/apply_schema.py
# 例: postgresql://postgres....@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ========== Edge Function secrets（supabase secrets set …；勿写进 APK）==========
# 大模型对话代理 llm-chat
# LLM_PROVIDER=auto
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# ZHIPU_API_KEY=
# BAIDU_LLM_API_KEY=
# ASR_API_KEY=   # 硅基等也可复用
# ONE_API_BASE_URL=
# ONE_API_KEY=

# ASR 代理 asr-transcribe
# BAIDU_ASR_API_KEY=
# BAIDU_ASR_SECRET_KEY=
# GROQ_API_KEY=
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_API_KEY=
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# 识图代理 vision-understand
# ZHIPU_API_KEY=
# ZHIPU_VISION_MODEL=glm-4v-flash
# GEMINI_API_KEY=
# VISION_API_KEY=

# ========== 临时：仍可 bake 的旧直连 Key（deprecated，仅开发回退）==========
# 正式分发请留空，改走 Edge；下方仅方便本地调试
USE_LLM=true
USE_CLOUD_ASR=true
LLM_PROVIDER=auto
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_VISION_MODEL=glm-4v-flash
BAIDU_LLM_API_KEY=
BAIDU_LLM_BASE_URL=https://qianfan.baidubce.com/v2
BAIDU_LLM_MODEL=ernie-speed-8k
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICON_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
ONE_API_BASE_URL=
ONE_API_KEY=
ONE_API_MODEL=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ASR_MODEL=whisper-large-v3-turbo
