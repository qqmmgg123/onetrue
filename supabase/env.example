# 复制本文件为 env.local 后填入真实值（env.local 不会提交到 git）
# 在 Supabase：Project Settings → API / Database

# Project URL，例如 https://abcdefgh.supabase.co
SUPABASE_URL=

# Settings → API → anon public
SUPABASE_ANON_KEY=

# Settings → Database → Database password（新建项目时设置的密码）
SUPABASE_DB_PASSWORD=

# 可选：完整连接串（填了则优先用这个，可忽略上面的 URL/密码）
# 在 Database Settings → Connection string → URI
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=
