# 复制本文件为 env.local 后填入真实值（env.local / dart_defines.json 不会提交）
# 打包 APK：在项目根目录执行 .\build_apk.ps1

# ========== 打进 App（模型 / 同步）==========

# 大模型对话：auto=智谱→百度→硅基（有 One API 则优先网关）
# 可选：auto | zhipu | baidu | silicon | oneapi | deepseek
LLM_PROVIDER=auto
USE_LLM=true

# 智谱（对话 glm-4-flash + 识图 glm-4v-flash 共用 Key）→ https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_VISION_MODEL=glm-4v-flash

# 百度千帆对话（OpenAI 兼容 v2；与下面 ASR 的 AK/SK 分开）
# 控制台 → 应用接入 → API Key（Bearer）
BAIDU_LLM_API_KEY=
BAIDU_LLM_BASE_URL=https://qianfan.baidubce.com/v2
BAIDU_LLM_MODEL=ernie-speed-8k

# 硅基流动：ASR 与对话可共用 ASR_API_KEY；对话模型单独指定
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICON_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
USE_CLOUD_ASR=true

# One API / New API 聚合网关（部署后填写；auto 将优先只打这里）
ONE_API_BASE_URL=
ONE_API_KEY=
ONE_API_MODEL=

# DeepSeek（付费，设置页高级区；默认不优先）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash

# 百度智能云（短语音 + 通用文字识别 OCR 共用同一套 Key）
# 控制台需分别开通「短语音识别」与「文字识别-通用文字识别（高精度版）」并应用授权；OCR 有每日免费额度
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=

# Groq Whisper（第二优先）
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ASR_MODEL=whisper-large-v3-turbo

# Neon Postgres（Dashboard → Connection Details → Connection string）
# 推荐选 pooled / -pooler 主机，区域尽量近（如新加坡）
# 例: postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 不要加 channel_binding=require（Windows 打包时 & 会出错）
DATABASE_URL=

# 多台手机共用同一 owner；随机 UUID 即可
SYNC_OWNER_ID=
SYNC_ENABLED=true

# 七牛云（房间视频，优先）。控制台 → 密钥管理 / 空间管理
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 空间绑定的 CDN 域名（需能公网访问），不要末尾 /
# 注意：*.clouddn.com 测试域名 https 证书常无效，请用 http://；正式自定义域名再用 https://
QINIU_PUBLIC_BASE=http://xxx.hd-bkt.clouddn.com
# 上传域名按空间区域选：华东 upload.qiniup.com / 华北 upload-z1 / 华南 upload-z2
QINIU_UPLOAD_HOST=https://upload.qiniup.com
# 可选：多媒体队列名（云端转码暂未启用；以后若打开再填）
QINIU_PIPELINE=

# Cloudflare R2（备用：七牛失败时）。Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 桶的公开访问前缀（r2.dev 或自定义域名），不要末尾 /
R2_PUBLIC_BASE=https://pub-xxxx.r2.dev

# 分享站根地址（EdgeOne Makers / 国内域名，部署 share-web 后填写）
SHARE_WEB_BASE=https://your-project.edgeone.app
# 分享页「下载 App」链接；不填则打包时默认 {QINIU_PUBLIC_BASE}/app/rent_agent.apk
# （与 .\build_apk.ps1 -Publish 覆盖上传的是同一份）
APP_DOWNLOAD_URL=
APP_DOWNLOAD_HINT=点击下载缘初 App（Android）
# 可选：更新清单地址。不填则默认 {QINIU_PUBLIC_BASE}/app/version.json
# 发布：.\build_apk.ps1 -Publish （会上传 APK + version.json）
APP_UPDATE_MANIFEST_URL=

# 微信开放平台移动应用（分享网页卡片必需）
# 在 https://open.weixin.qq.com 创建移动应用，填包名 com.local.rent.rent_agent + 签名 MD5
WECHAT_APP_ID=
# iOS 通用链接（仅 iOS 需要；Android 可留空）
WECHAT_UNIVERSAL_LINK=
